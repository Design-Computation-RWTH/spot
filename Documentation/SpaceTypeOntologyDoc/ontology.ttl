@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/spot/> .

<https://w3id.org/spot/> rdf:type owl:Ontology ;
                          <http://purl.org/dc/terms/created> "2025-12-01" ;
                          <http://purl.org/dc/terms/creator> _:genid1 ,
                                                             _:genid3 ,
                                                             _:genid5 ;
                          <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                          <http://purl.org/dc/terms/title> "Space Types Ontology"@en ;
                          <http://purl.org/vocab/vann/preferredNamespacePrefix> "spot" ;
                          <http://purl.org/vocab/vann/preferredNamespaceUri> <https://w3id.org/spot#> ;
                          rdfs:comment """Space Types Ontology (SPOT) for describing spaces, appearances, and their relationships,
        in the context of the AECO domain"""@en ;
                          rdfs:label "SPOT Ontology"@en ;
                          owl:versionInfo "1.0.0" .

_:genid1 rdf:type <http://schema.org/Person> ;
          <http://schema.org/affiliation> _:genid2 ;
          <http://schema.org/name> "Anne Göbels" ;
          <http://schema.org/url> "https://dc.rwth-aachen.de/anne-gobels/" .

_:genid3 rdf:type <http://schema.org/Person> ;
          <http://schema.org/affiliation> _:genid4 ;
          <http://schema.org/name> "Oliver Schulz" ;
          <http://schema.org/url> "https://dc.rwth-aachen.de/oliver-schulz/" .

_:genid5 rdf:type <http://schema.org/Person> ;
          <http://schema.org/affiliation> _:genid6 ;
          <http://schema.org/name> "Fabian Rolke" ;
          <http://schema.org/url> "https://dc.rwth-aachen.de/fabian-rolke/" .

_:genid2 rdf:type <http://schema.org/Organization> ;
          <http://schema.org/name> "Design Computation, RWTH Aachen University" ;
          <http://schema.org/url> "https://dc.rwth-aachen.de/" .

_:genid4 rdf:type <http://schema.org/Organization> ;
          <http://schema.org/name> "Design Computation, RWTH Aachen University" ;
          <http://schema.org/url> "https://dc.rwth-aachen.de/" .

_:genid6 rdf:type <http://schema.org/Organization> ;
          <http://schema.org/name> "Design Computation, RWTH Aachen University" ;
          <http://schema.org/url> "https://dc.rwth-aachen.de/" .

