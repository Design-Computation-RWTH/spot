    <!-- https://w3id.org/spot#Appearance -->


    <owl:Class rdf:about="https://w3id.org/spot#Appearance">
        <rdfs:comment xml:lang="en">The appearance of an entity space in a reference space (Asset, Document or another Entity Space).
    The appearance object serves as a container/reference to assign spatial relation definitions for the relationship
    between the Entity Space instance and the space where it appears in.</rdfs:comment>
        <rdfs:label xml:lang="en">Appearance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#AreaSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#AreaSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#EntitySpace"/>
        <rdfs:comment xml:lang="en">A two-dimensional space that can be used to represent resources like 2D drawings or maps </rdfs:comment>
        <rdfs:label xml:lang="en">Area Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#AssetAppearance -->


    <owl:Class rdf:about="https://w3id.org/spot#AssetAppearance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#Appearance"/>
        <rdfs:comment xml:lang="en">The appearance of entity space in an asset space</rdfs:comment>
        <rdfs:label xml:lang="en">Asset Appearance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#AssetSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#AssetSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#PhysicalSpace"/>
        <rdfs:comment xml:lang="en">&quot;The Asset Space represents the actual, physical asset.
        An instance of the Asset Space is the superordinate object for the spatial superimposition of Entity Space instances.</rdfs:comment>
        <rdfs:label xml:lang="en">Asset Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#Axis -->


    <owl:Class rdf:about="https://w3id.org/spot#Axis">
        <rdfs:comment xml:lang="en">An axis of the local coordinate system of a space instance</rdfs:comment>
        <rdfs:label xml:lang="en">Axis</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#Direction -->


    <owl:Class rdf:about="https://w3id.org/spot#Direction">
        <rdfs:comment xml:lang="en">The defined direction of an axis (e.g., an X-Axis is pointing to the &apos;Front&apos; of the asset,
     or an Y-Axis is pointing to the &apos;Bottom&apos; of a document / plan ).
     Only Asset Space or Document Space Axis should get an Direction Definition.</rdfs:comment>
        <rdfs:label xml:lang="en">Direction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#DocumentAppearance -->


    <owl:Class rdf:about="https://w3id.org/spot#DocumentAppearance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#Appearance"/>
        <rdfs:comment xml:lang="en">The appearance of an entity space in a document space</rdfs:comment>
        <rdfs:label xml:lang="en">Document Appearance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#DocumentSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#DocumentSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#VirtualSpace"/>
        <rdfs:comment xml:lang="en">The Document Space represents the extent of a document or file that contains Entity Spaces.
    A Document Space can represent different, disjointed Entity Spaces, such as a collection of sections and
     details on a construction plan.</rdfs:comment>
        <rdfs:label xml:lang="en">Document Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#EntityAppearance -->


    <owl:Class rdf:about="https://w3id.org/spot#EntityAppearance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#Appearance"/>
        <rdfs:comment xml:lang="en">The appearance of an entity space in another (parent/super) entity space</rdfs:comment>
        <rdfs:label xml:lang="en">Entity Appearance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#EntitySpace -->


    <owl:Class rdf:about="https://w3id.org/spot#EntitySpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#PhysicalSpace"/>
        <rdfs:comment xml:lang="en">The Entity Space is a coherent unit of information covered by a single resource, such as a 3D model,
     a 2D drawing, or a picture, representing its actual dimensions referring to the Asset Space.</rdfs:comment>
        <rdfs:label xml:lang="en">Entity Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#HorizontalAreaSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#HorizontalAreaSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#AreaSpace"/>
        <rdfs:comment xml:lang="en">The Horizontal Area Space is a subtype of Area Space, that implies that the plane of the resource
     is parallel to the horizontal plane of the asset space. Floorplans or maps are typical horizontal area spaces.</rdfs:comment>
        <rdfs:label xml:lang="en">Horizontal Area Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#LineSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#LineSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#EntitySpace"/>
        <rdfs:comment xml:lang="en">A one-dimensional space that can be used to represent e.g., vertical height references such as water levels </rdfs:comment>
        <rdfs:label xml:lang="en">Line Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#PhysicalSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#PhysicalSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#Space"/>
        <rdfs:comment xml:lang="en">The Physical Space is the superclass for the global, asset and entity spaces,
    which implies that these spaces are can be directly mapped in physical space, as opposite to virtual spaces.
    It is an abstract class and should not be used directly.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#PointSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#PointSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#EntitySpace"/>
        <rdfs:comment xml:lang="en">The Point Space can represent resources that only need one point of reference,
    such as the camera position of a picture or the position of a sensor.</rdfs:comment>
        <rdfs:label xml:lang="en">Point Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#Space -->


    <owl:Class rdf:about="https://w3id.org/spot#Space">
        <rdfs:comment xml:lang="en">The abstract superclass for all defined space types.</rdfs:comment>
        <rdfs:label xml:lang="en">Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#VerticalAreaSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#VerticalAreaSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#AreaSpace"/>
        <rdfs:comment xml:lang="en">The Vertical Area Space is a subtype of Area Space, that implies that the plane of the resource is
     parallel to the vertical axis of the asset space. Section drawings are typical vertical area spaces.</rdfs:comment>
        <rdfs:label xml:lang="en">Vertical Area Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#VirtualSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#VirtualSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#Space"/>
        <rdfs:comment xml:lang="en">The Virtual Space represent resource spaces, which cannot be directly mapped to the real physical space,
     as their spatial arrangement is artificial. For example 2D plans with a collection of drawings
     or a file containing multiple disjointed 3D models of the same asset.  It is an abstract class and should not be used directly.</rdfs:comment>
        <rdfs:label xml:lang="en">Virtual Space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot#VolumeSpace -->


    <owl:Class rdf:about="https://w3id.org/spot#VolumeSpace">
        <rdfs:subClassOf rdf:resource="https://w3id.org/spot#EntitySpace"/>
        <rdfs:comment xml:lang="en">The Volume Space can represent three-dimensional resources, such as 3D models or point clouds.</rdfs:comment>
        <rdfs:label xml:lang="en">Volume Space</rdfs:label>
    </owl:Class>
    


