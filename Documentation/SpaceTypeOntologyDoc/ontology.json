    "@value" : "The Volume Space can represent three-dimensional resources, such as 3D models or point clouds."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Volume Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#EntitySpace"
  } ]
}, {
