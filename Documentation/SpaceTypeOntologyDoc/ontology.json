    "@language" : "en",
    "@value" : "The appearance of entity space in an asset space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Asset Appearance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#Appearance"
  } ]
}, {
