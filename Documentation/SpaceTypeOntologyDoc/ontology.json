    "@language" : "en",
    "@value" : "A two-dimensional space that can be used to represent resources like 2D drawings or maps "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Area Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#EntitySpace"
  } ]
}, {
