  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "\"The Asset Space represents the actual, physical asset.\r\n        An instance of the Asset Space is the superordinate object for the spatial superimposition of Entity Space instances."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Asset Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#PhysicalSpace"
  } ]
}, {
