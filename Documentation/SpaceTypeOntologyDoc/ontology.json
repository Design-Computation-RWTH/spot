  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The front of an asset or document space."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Front"
  } ],
  "https://w3id.org/spot#isInverseDirectionOf" : [ {
    "@id" : "https://w3id.org/spot#Rear"
  } ]
}, {
  "@id" : "https://w3id.org/spot#HorizontalAreaSpace",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Horizontal Area Space is a subtype of Area Space, that implies that the plane of the resource\r\n     is parallel to the horizontal plane of the asset space. Floorplans or maps are typical horizontal area spaces."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Horizontal Area Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#AreaSpace"
  } ]
}, {
  "@id" : "https://w3id.org/spot#Left",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/spot#Direction" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The left of an asset or document space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Left"
  } ],
  "https://w3id.org/spot#isInverseDirectionOf" : [ {
    "@id" : "https://w3id.org/spot#Right"
  } ]
}, {
  "@id" : "https://w3id.org/spot#LineSpace",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A one-dimensional space that can be used to represent e.g., vertical height references such as water levels "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Line Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#EntitySpace"
  } ]
}, {
  "@id" : "https://w3id.org/spot#PhysicalSpace",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Physical Space is the superclass for the global, asset and entity spaces,\r\n    which implies that these spaces are can be directly mapped in physical space, as opposite to virtual spaces.\r\n    It is an abstract class and should not be used directly."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Physical Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#Space"
  } ]
}, {
  "@id" : "https://w3id.org/spot#PointSpace",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Point Space can represent resources that only need one point of reference,\r\n    such as the camera position of a picture or the position of a sensor."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Point Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#EntitySpace"
  } ]
