  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The defined direction of an axis (e.g., an X-Axis is pointing to the 'Front' of the asset,\r\n     or an Y-Axis is pointing to the 'Bottom' of a document / plan ).\r\n     Only Asset Space or Document Space Axis should get an Direction Definition."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Direction"
  } ]
}, {
  "@id" : "https://w3id.org/spot#DocumentAppearance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The appearance of an entity space in a document space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Document Appearance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#Appearance"
  } ]
}, {
  "@id" : "https://w3id.org/spot#DocumentSpace",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Document Space represents the extent of a document or file that contains Entity Spaces.\r\n    A Document Space can represent different, disjointed Entity Spaces, such as a collection of sections and\r\n     details on a construction plan."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Document Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#VirtualSpace"
  } ]
}, {
  "@id" : "https://w3id.org/spot#EntityAppearance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The appearance of an entity space in another (parent/super) entity space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Entity Appearance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#Appearance"
  } ]
}, {
  "@id" : "https://w3id.org/spot#EntitySpace",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Entity Space is a coherent unit of information covered by a single resource, such as a 3D model,\r\n     a 2D drawing, or a picture, representing its actual dimensions referring to the Asset Space."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Entity Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#PhysicalSpace"
  } ]
}, {
  "@id" : "https://w3id.org/spot#Front",
