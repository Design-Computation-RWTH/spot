    "@value" : "The appearance of an entity space in a reference space (Asset, Document or another Entity Space).\r\n    The appearance object serves as a container/reference to assign spatial relation definitions for the relationship\r\n    between the Entity Space instance and the space where it appears in."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Appearance"
  } ]
