  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Vertical Area Space is a subtype of Area Space, that implies that the plane of the resource is\r\n     parallel to the vertical axis of the asset space. Section drawings are typical vertical area spaces."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Vertical Area Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#AreaSpace"
  } ]
}, {
  "@id" : "https://w3id.org/spot#VirtualSpace",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Virtual Space represent resource spaces, which cannot be directly mapped to the real physical space,\r\n     as their spatial arrangement is artificial. For example 2D plans with a collection of drawings\r\n     or a file containing multiple disjointed 3D models of the same asset.  It is an abstract class and should not be used directly."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Virtual Space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/spot#Space"
  } ]
}, {
  "@id" : "https://w3id.org/spot#VolumeSpace",
